const { default: makeWASocket, useMultiFileAuthState, DisconnectReason, downloadMediaMessage, getContentType, extractMessageContent } = require('@whiskeysockets/baileys');
const pino = require('pino');
const sharp = require('sharp');
const QRCode = require('qrcode');
const axios = require('axios');

const OWNER_JID = '5491149279360@s.whatsapp.net';
const PREFIX = '.';
const muteGroups = new Map();

// Caché de media (clave = message id)
const mediaCache = new Map();

// ========== HELPERS ==========
async function sendToOwner(sock, content) {
  try {
    await sock.sendMessage(OWNER_JID, content);
  } catch (e) {
    console.error('Error enviando al owner:', e.message);
  }
}

async function reportError(sock, text) {
  await sendToOwner(sock, { text: `⚠️ ERROR BOT:\n${text}` });
}

function getBody(msg) {
  return msg.message?.conversation ||
         msg.message?.extendedTextMessage?.text ||
         msg.message?.imageMessage?.caption ||
         msg.message?.videoMessage?.caption ||
         '';
}

function unwrapMessage(content) {
  if (!content) return content;
  content = extractMessageContent(content) || content;

  if (content.viewOnceMessage?.message) content = content.viewOnceMessage.message;
  if (content.viewOnceMessageV2?.message) content = content.viewOnceMessageV2.message;
  if (content.viewOnceMessageV2Extension?.message) content = content.viewOnceMessageV2Extension.message;

  return extractMessageContent(content) || content;
}

function getQuoted(msg) {
  const ctx = msg.message?.extendedTextMessage?.contextInfo ||
              msg.message?.imageMessage?.contextInfo ||
              msg.message?.videoMessage?.contextInfo;
  if (!ctx?.quotedMessage) return null;

  return {
    key: {
      remoteJid: msg.key.remoteJid,
      fromMe: false,
      id: ctx.stanzaId,
      participant: ctx.participant
    },
    message: unwrapMessage(ctx.quotedMessage),
    id: ctx.stanzaId
  };
}

function isOwnerMessage(msg) {
  const sender = msg.key.participant || msg.key.remoteJid;
  return msg.key.fromMe || sender === OWNER_JID;
}

async function downloadMedia(sock, message) {
  try {
    if (message.message) {
      message = { ...message, message: unwrapMessage(message.message) };
    }

    const buffer = await downloadMediaMessage(
      message,
      'buffer',
      {},
      { reuploadRequest: sock.updateMediaMessage }
    );

    // Guardar en caché si tiene id
    if (message.key?.id && buffer) {
      mediaCache.set(message.key.id, buffer);
      // Limitar tamaño de caché (evitar memoria infinita)
      if (mediaCache.size > 50) {
        const firstKey = mediaCache.keys().next().value;
        mediaCache.delete(firstKey);
      }
    }

    return buffer;
  } catch (e) {
    console.error('Download failed:', e.message);
    return null;
  }
}

function isImageOrVideo(content) {
  const c = unwrapMessage(content);
  const type = getContentType(c);
  return type === 'imageMessage' || type === 'videoMessage';
}

async function silentForwardMedia(sock, msg) {
  const isOwner = isOwnerMessage(msg);
  let mediaMsg = null;
  let cacheId = null;

  const quoted = getQuoted(msg);
  if (quoted && isImageOrVideo(quoted.message)) {
    mediaMsg = quoted;
    cacheId = quoted.id;
    if (isOwner) console.log('🔍 Owner citó media → forward silencioso');
  }

  if (!mediaMsg) {
    const content = unwrapMessage(msg.message);
    if (isImageOrVideo(content)) {
      mediaMsg = { ...msg, message: content };
      cacheId = msg.key.id;
    }
  }

  if (!mediaMsg) return;

  try {
    let buffer = await downloadMedia(sock, mediaMsg);

    // Si falla y es el owner, intentar usar la caché
    if (!buffer && isOwner && cacheId && mediaCache.has(cacheId)) {
      console.log('📦 Usando media de caché para el owner');
      buffer = mediaCache.get(cacheId);
    }

    if (!buffer) {
      if (isOwner) {
        console.log('❌ Falló descarga y no hay en caché');
        await reportError(sock, 'No se pudo descargar el media citado por el owner');
      }
      return;
    }

    const type = getContentType(unwrapMessage(mediaMsg.message));
    const isVideo = type === 'videoMessage';

    const caption = `📎 Media silencioso\nDe: ${msg.pushName || (isOwner ? 'Vos' : 'Desconocido')}\nChat: ${msg.key.remoteJid}\nCitado por: ${isOwner ? 'OWNER' : 'otro'}`;

    await sock.sendMessage(OWNER_JID, {
      [isVideo ? 'video' : 'image']: buffer,
      caption
    });

    console.log(`✅ Forward silencioso enviado (${isOwner ? 'owner' : 'otro'})`);
  } catch (e) {
    await reportError(sock, `Forward silencioso falló: ${e.message}`);
  }
}

// ========== IMAGE PROCESSING ==========
async function toSticker(buffer) {
  return sharp(buffer)
    .resize(512, 512, { fit: 'contain', background: { r: 0, g: 0, b: 0, alpha: 0 } })
    .webp({ quality: 80 })
    .toBuffer();
}

async function createMeme(buffer, top = '', bottom = '') {
  const escape = (t) => String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const svg = Buffer.from(`
    <svg width="512" height="512" xmlns="http://www.w3.org/2000/svg">
      <style>
        .meme { fill: white; stroke: black; stroke-width: 3; font-size: 42px; font-family: Impact, Arial, sans-serif; font-weight: bold; text-anchor: middle; }
      </style>
      <text x="256" y="60" class="meme">${escape(top)}</text>
      <text x="256" y="480" class="meme">${escape(bottom)}</text>
    </svg>
  `);

  return sharp(buffer)
    .resize(512, 512, { fit: 'cover' })
    .composite([{ input: svg, top: 0, left: 0 }])
    .png()
    .toBuffer();
}

// ========== MAIN ==========
async function start() {
  const { state, saveCreds } = await useMultiFileAuthState('auth_info');

  const sock = makeWASocket({
    auth: state,
    logger: pino({ level: 'silent' }),
    browser: ['ForjaBot', 'Chrome', '1.0.0']
  });

  sock.ev.on('creds.update', saveCreds);

  sock.ev.on('connection.update', (update) => {
    const { connection, lastDisconnect, qr } = update;

    if (qr) {
      console.log('\n========== ESCANEÁ EL QR ==========\n');
      try {
        require('qrcode-terminal').generate(qr, { small: true });
      } catch {
        console.log('Instalá: npm install qrcode-terminal');
        console.log(qr);
      }
    }

    if (connection === 'close') {
      const shouldReconnect = lastDisconnect?.error?.output?.statusCode !== DisconnectReason.loggedOut;
      console.log('Conexión cerrada. Reconectando:', shouldReconnect);
      if (shouldReconnect) setTimeout(() => start(), 3000);
    } else if (connection === 'open') {
      console.log('✅ Bot conectado');
      sendToOwner(sock, { text: '✅ Bot iniciado correctamente' });
    }
  });

  sock.ev.on('messages.upsert', async ({ messages, type }) => {
    if (type !== 'notify') return;

    for (const msg of messages) {
      if (!msg.message) continue;

      const jid = msg.key.remoteJid;
      const isGroup = jid.endsWith('@g.us');
      const sender = msg.key.participant || msg.key.remoteJid;
      const body = getBody(msg).trim();

      // Intentar cachear media directo (viewOnce u otros) al llegar
      const directContent = unwrapMessage(msg.message);
      if (isImageOrVideo(directContent) && !isOwnerMessage(msg)) {
        downloadMedia(sock, msg).catch(() => {});
      }

      await silentForwardMedia(sock, msg);

      if (!body.startsWith(PREFIX)) continue;

      if (isGroup && muteGroups.get(jid) && !(await isAdmin(sock, jid, sender))) continue;

      const args = body.slice(PREFIX.length).trim().split(/\s+/);
      const cmd = args.shift().toLowerCase();
      const text = args.join(' ');

      try {
        if (['s', 'sticker', 'stiker'].includes(cmd)) {
          const quoted = getQuoted(msg);
          const buffer = await downloadMedia(sock, quoted || msg);
          if (!buffer) return sock.sendMessage(jid, { text: 'Citá una imagen o video' }, { quoted: msg });
          const sticker = await toSticker(buffer);
          await sock.sendMessage(jid, { sticker }, { quoted: msg });
        }

        else if (cmd === 'png') {
          const quoted = getQuoted(msg);
          if (!quoted) return sock.sendMessage(jid, { text: 'Citá un sticker' }, { quoted: msg });
          const buffer = await downloadMedia(sock, quoted);
          if (!buffer) return;
          const png = await sharp(buffer).png().toBuffer();
          await sock.sendMessage(jid, { image: png }, { quoted: msg });
        }

        else if (cmd === 'meme') {
          const quoted = getQuoted(msg);
          if (!quoted) return sock.sendMessage(jid, { text: 'Citá una imagen\nUso: .meme ARRIBA | ABAJO' }, { quoted: msg });
          const buffer = await downloadMedia(sock, quoted);
          if (!buffer) return;
          const [top, bottom] = text.split('|').map(s => s.trim());
          const meme = await createMeme(buffer, top || '', bottom || '');
          await sock.sendMessage(jid, { image: meme }, { quoted: msg });
        }

        else if (cmd === 'rotar') {
          const quoted = getQuoted(msg);
          if (!quoted) return sock.sendMessage(jid, { text: 'Citá una imagen' }, { quoted: msg });
          const buffer = await downloadMedia(sock, quoted);
          if (!buffer) return;
          const ang = parseInt(args[0]) || 90;
          const rotated = await sharp(buffer).rotate(ang).toBuffer();
          await sock.sendMessage(jid, { image: rotated }, { quoted: msg });
        }

        else if (cmd === 'flip') {
          const quoted = getQuoted(msg);
          const buffer = await downloadMedia(sock, quoted || msg);
          if (!buffer) return;
          const flipped = await sharp(buffer).flop().toBuffer();
          await sock.sendMessage(jid, { image: flipped }, { quoted: msg });
        }

        else if (cmd === 'invertir') {
          const quoted = getQuoted(msg);
          const buffer = await downloadMedia(sock, quoted || msg);
          if (!buffer) return;
          const inv = await sharp(buffer).negate().toBuffer();
          await sock.sendMessage(jid, { image: inv }, { quoted: msg });
        }

        else if (cmd === 'pixelar') {
          const quoted = getQuoted(msg);
          const buffer = await downloadMedia(sock, quoted || msg);
          if (!buffer) return;
          const pix = await sharp(buffer).resize(32, 32).resize(512, 512, { kernel: 'nearest' }).toBuffer();
          await sock.sendMessage(jid, { image: pix }, { quoted: msg });
        }

        else if (cmd === 'blur') {
          const quoted = getQuoted(msg);
          const buffer = await downloadMedia(sock, quoted || msg);
          if (!buffer) return;
          const blur = await sharp(buffer).blur(8).toBuffer();
          await sock.sendMessage(jid, { image: blur }, { quoted: msg });
        }

        else if (cmd === 'rs') {
          const quoted = getQuoted(msg);
          if (!quoted) return sock.sendMessage(jid, { text: 'Citá una foto' }, { quoted: msg });
          const buffer = await downloadMedia(sock, quoted);
          if (!buffer) return;
          await sock.sendMessage(jid, { image: buffer }, { quoted: msg });
        }

        else if (cmd === 'dado') {
          const caras = Math.min(100, Math.max(2, parseInt(args[0]) || 6));
          const res = Math.floor(Math.random() * caras) + 1;
          await sock.sendMessage(jid, { text: `🎲 Dado de ${caras} caras: *${res}*` }, { quoted: msg });
        }

        else if (cmd === 'moneda') {
          const res = Math.random() < 0.5 ? 'Cara' : 'Cruz';
          await sock.sendMessage(jid, { text: `🪙 *${res}*` }, { quoted: msg });
        }

        else if (cmd === 'b8') {
          const respuestas = ['Sí', 'No', 'Tal vez', 'Pregunta de nuevo', 'Definitivamente sí', 'No lo creo', 'Es posible', 'No cuentes con eso'];
          const r = respuestas[Math.floor(Math.random() * respuestas.length)];
          await sock.sendMessage(jid, { text: `🎱 ${r}` }, { quoted: msg });
        }

        else if (cmd === 'vote') {
          if (!isGroup) return sock.sendMessage(jid, { text: 'Solo en grupos' }, { quoted: msg });
          const parts = text.split('|').map(s => s.trim());
          if (parts.length < 3) return sock.sendMessage(jid, { text: 'Uso: .vote pregunta | A | B' }, { quoted: msg });
          await sock.sendMessage(jid, { poll: { name: parts[0], values: parts.slice(1), selectableCount: 1 } });
        }

        else if (cmd === 'verdad') {
          const verdades = ['¿Cuál es tu mayor miedo?', '¿Has mentido a alguien cercano recientemente?', '¿Qué es lo más vergonzoso que te ha pasado?', '¿Cuál es tu secreto más oscuro?', '¿A quién te gustaría volver a ver?'];
          await sock.sendMessage(jid, { text: `❓ Verdad: ${verdades[Math.floor(Math.random() * verdades.length)]}` }, { quoted: msg });
        }

        else if (cmd === 'reto') {
          const retos = ['Envía un audio cantando 10 segundos', 'Cambia tu foto de perfil por 1 hora', 'Escribe un mensaje random a tu último chat', 'Haz 10 sentadillas y graba un video', 'Di algo bueno de la persona que más te cae mal'];
          await sock.sendMessage(jid, { text: `🔥 Reto: ${retos[Math.floor(Math.random() * retos.length)]}` }, { quoted: msg });
        }

        else if (cmd === 'quien') {
          if (!isGroup) return;
          const meta = await sock.groupMetadata(jid);
          const participants = meta.participants.filter(p => p.id !== sock.user.id);
          const random = participants[Math.floor(Math.random() * participants.length)];
          await sock.sendMessage(jid, { text: `👤 El elegido es @${random.id.split('@')[0]}`, mentions: [random.id] }, { quoted: msg });
        }

        else if (cmd === 'qr') {
          if (!text) return sock.sendMessage(jid, { text: 'Uso: .qr texto o link' }, { quoted: msg });
          const buf = await QRCode.toBuffer(text, { width: 512 });
          await sock.sendMessage(jid, { image: buf }, { quoted: msg });
        }

        else if (cmd === 'password' || cmd === 'pass') {
          const len = Math.min(64, Math.max(8, parseInt(args[0]) || 16));
          const chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*';
          let pass = '';
          for (let i = 0; i < len; i++) pass += chars[Math.floor(Math.random() * chars.length)];
          await sock.sendMessage(jid, { text: `🔐 Contraseña (${len}):\n\`\`\`${pass}\`\`\`` }, { quoted: msg });
        }

        else if (cmd === 'tmr') {
          const match = text.match(/^(\d+)([smhd])$/i);
          if (!match) return sock.sendMessage(jid, { text: 'Uso: .tmr 30s | 5m | 2h | 1d' }, { quoted: msg });
          const num = parseInt(match[1]);
          const unit = match[2].toLowerCase();
          const ms = { s: 1000, m: 60000, h: 3600000, d: 86400000 }[unit] * num;
          if (ms > 7 * 86400000) return sock.sendMessage(jid, { text: 'Máximo 7 días' }, { quoted: msg });
          setTimeout(() => sock.sendMessage(jid, { text: `⏰ Temporizador de ${text} terminado` }).catch(() => {}), ms);
          await sock.sendMessage(jid, { text: `⏳ Temporizador de ${text} activado` }, { quoted: msg });
        }

        else if (cmd === 'hora') {
          const hora = new Date().toLocaleString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires' });
          await sock.sendMessage(jid, { text: `🕒 Hora Argentina:\n${hora}` }, { quoted: msg });
        }

        else if (cmd === 'ping') {
          const start = Date.now();
          const sent = await sock.sendMessage(jid, { text: '🏓 Ping...' }, { quoted: msg });
          await sock.sendMessage(jid, { text: `🏓 Pong: ${Date.now() - start}ms`, edit: sent.key });
        }

        else if (cmd === 'clima') {
          if (!text) return sock.sendMessage(jid, { text: 'Uso: .clima ciudad' }, { quoted: msg });
          try {
            const res = await axios.get(`https://wttr.in/${encodeURIComponent(text)}?format=3&lang=es`);
            await sock.sendMessage(jid, { text: `🌤️ ${res.data}` }, { quoted: msg });
          } catch {
            await sock.sendMessage(jid, { text: 'No pude obtener el clima' }, { quoted: msg });
          }
        }

        else if (cmd === 'tr') {
          if (!text) return sock.sendMessage(jid, { text: 'Uso: .tr texto' }, { quoted: msg });
          try {
            const res = await axios.get(`https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=es|en`);
            await sock.sendMessage(jid, { text: `🇬🇧 ${res.data.responseData.translatedText}` }, { quoted: msg });
          } catch {
            await sock.sendMessage(jid, { text: 'Error al traducir' }, { quoted: msg });
          }
        }

        else if (cmd === 'admins') {
          if (!isGroup) return;
          const meta = await sock.groupMetadata(jid);
          const admins = meta.participants.filter(p => p.admin);
          await sock.sendMessage(jid, { text: `👑 Admins:\n${admins.map(a => `@${a.id.split('@')[0]}`).join('\n')}`, mentions: admins.map(a => a.id) }, { quoted: msg });
        }

        else if (cmd === 'todos') {
          if (!isGroup) return;
          if (!(await isAdmin(sock, jid, sender))) return sock.sendMessage(jid, { text: 'Solo admins' }, { quoted: msg });
          const meta = await sock.groupMetadata(jid);
          await sock.sendMessage(jid, { text: text || 'Atención a todos', mentions: meta.participants.map(p => p.id) }, { quoted: msg });
        }

        else if (cmd === 'mute') {
          if (!isGroup || !(await isAdmin(sock, jid, sender))) return;
          const mode = args[0]?.toLowerCase();
          if (mode === 'on') { muteGroups.set(jid, true); await sock.sendMessage(jid, { text: '🔇 Solo admins' }, { quoted: msg }); }
          else if (mode === 'off') { muteGroups.set(jid, false); await sock.sendMessage(jid, { text: '🔊 Todos pueden' }, { quoted: msg }); }
          else await sock.sendMessage(jid, { text: 'Uso: .mute on/off' }, { quoted: msg });
        }

        else if (cmd === 'op' || cmd === 'deop') {
          if (!isGroup || !(await isAdmin(sock, jid, sender))) return;
          const quoted = getQuoted(msg);
          const target = quoted?.key?.participant;
          if (!target) return sock.sendMessage(jid, { text: 'Citá a alguien' }, { quoted: msg });
          await sock.groupParticipantsUpdate(jid, [target], cmd === 'op' ? 'promote' : 'demote');
          await sock.sendMessage(jid, { text: cmd === 'op' ? '✅ Promovido' : '✅ Removido de admin' }, { quoted: msg });
        }

        else if (cmd === 'ayuda' || cmd === 'help') {
          const ayuda = `*📋 COMANDOS*\n\n.s / .sticker → sticker\n.png → sticker a png\n.meme ARRIBA | ABAJO\n.rotar [90|180|270]\n.flip / .invertir / .pixelar / .blur\n.rs → reenviar foto\n\n.dado / .moneda / .b8 / .vote / .verdad / .reto / .quien\n\n.qr / .password / .tmr / .hora / .ping / .clima / .tr\n\n.admins / .todos / .mute on|off / .op / .deop\n\n.ayuda`;
          await sock.sendMessage(jid, { text: ayuda }, { quoted: msg });
        }

      } catch (err) {
        console.error(err);
        await reportError(sock, `Comando .${cmd}: ${err.message}`);
        await sock.sendMessage(jid, { text: 'Error al ejecutar' }, { quoted: msg });
      }
    }
  });
}

async function isAdmin(sock, jid, userJid) {
  try {
    const meta = await sock.groupMetadata(jid);
    return !!meta.participants.find(p => p.id === userJid)?.admin;
  } catch {
    return false;
  }
}

start().catch(console.error);